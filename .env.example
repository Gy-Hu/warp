# OpenWarp 示例环境变量。
# 这个文件给本地开发、CI/release 脚本和 API 参数参考使用。
# Release 版桌面 app 设置 AI provider 时不需要 .env,也不会自动导入下面的 provider key。
# 不要把真实 .env 或真实密钥提交进仓库。

# ---- 构建 / release channel ----
# GitHub release workflow 和 bundle 脚本使用 oss channel 构建社区版本。
CHANNEL=oss

# ./script/run 会自动设置 WARP_CHANNEL。这里只作为调试参考。
WARP_CHANNEL=oss

# release tag 示例。新 release 请用实际 tag 替换。
GIT_RELEASE_TAG=v0.2026.06.19.15.47.oss_00

# ---- 后端覆盖变量 ----
# 正常 oss release 使用生产配置,无需设置这些变量。
# 只有在本地调试自建后端或 CLI/agent harness 时才需要。
WARP_SERVER_ROOT_URL=
WARP_WS_SERVER_URL=
WARP_SESSION_SHARING_SERVER_URL=
WARP_API_KEY=

# 下面这组只影响内部 channel config 生成流程;普通 oss 构建通常不要设置。
WITH_LOCAL_SERVER=
SERVER_ROOT_URL=
WS_SERVER_URL=

# ---- Cloud Agent / host 调试 ----
# 等价于 ./script/run --host-id <host-id> 后导出的变量。
WARP_CLOUD_MODE_DEFAULT_HOST=

# ---- AI provider 参数参考 ----
# 这些变量不会被桌面 app 自动读取为 AI 凭证。
# 请把对应值填到 Settings -> AI -> Providers。
OPENWARP_EXAMPLE_OPENAI_API_TYPE=OpenAI
OPENWARP_EXAMPLE_OPENAI_BASE_URL=https://api.openai.com/v1/
OPENWARP_EXAMPLE_OPENAI_MODEL="<model-id>"
OPENAI_API_KEY=

OPENWARP_EXAMPLE_OPENAI_RESPONSES_API_TYPE=OpenAI-Response
OPENWARP_EXAMPLE_OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1/
OPENWARP_EXAMPLE_OPENAI_RESPONSES_MODEL="<model-id>"

OPENWARP_EXAMPLE_OPENROUTER_API_TYPE=OpenAI
OPENWARP_EXAMPLE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENWARP_EXAMPLE_OPENROUTER_MODEL="<provider>/<model-id>"
OPENROUTER_API_KEY=

OPENWARP_EXAMPLE_DEEPSEEK_API_TYPE=DeepSeek
OPENWARP_EXAMPLE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/
OPENWARP_EXAMPLE_DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_API_KEY=

OPENWARP_EXAMPLE_ANTHROPIC_API_TYPE=Anthropic
OPENWARP_EXAMPLE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
OPENWARP_EXAMPLE_ANTHROPIC_MODEL="<model-id>"
ANTHROPIC_API_KEY=

OPENWARP_EXAMPLE_GEMINI_API_TYPE=Gemini
OPENWARP_EXAMPLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
OPENWARP_EXAMPLE_GEMINI_MODEL="<model-id>"
GEMINI_API_KEY=

OPENWARP_EXAMPLE_OLLAMA_API_TYPE=Ollama
OPENWARP_EXAMPLE_OLLAMA_BASE_URL=http://localhost:11434/v1/
OPENWARP_EXAMPLE_OLLAMA_MODEL="<local-model-id>"

# Web search tool 可选使用 EXA_API_KEY;不填时按匿名端点尝试。
EXA_API_KEY=
